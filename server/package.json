{
  "name": "eaf-agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent server: prompts, model routing and keys, logs. The browser sends input parts, never prompts.",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "models": "node scripts/get_models.mjs",
    "logs:export": "tsx src/store/cli.ts export",
    "logs:wipe": "tsx src/store/cli.ts wipe",
    "logs:report": "tsx src/store/cli.ts report"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@huggingface/transformers": "4.3.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
