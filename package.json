    "chai": "^4.2.0",
    "jsdom": "^16.4.0",
    "jsdom-global": "^3.0.2",
    "mocha": "^10.7.0",
    "sinon": "^9.0.1"
  },
  "peerDependencies": {
    "blockly": "^11.2.2"
  },
  "engines": {
    "node": ">=8.17.0"
  }
}
