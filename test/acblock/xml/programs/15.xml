<xml xmlns="https://developers.google.com/blockly/xml">
    <variables>
        <variable id="var_animal">animal</variable>
    </variables>
    <block type="text_print" id="print_1" x="20" y="20">
        <value name="TEXT">
            <block type="text" id="text_1">
                <field name="TEXT">Welcome to the Silly Sentence Maker!</field>
            </block>
        </value>
        <next>
            <block type="variables_set" id="set_1">
                <field name="VAR" id="var_animal">animal</field>
                <value name="VALUE">
                    <block type="text_prompt_ext" id="prompt_1">
                        <mutation type="TEXT"></mutation>
                        <field name="TYPE">TEXT</field>
                        <value name="TEXT">
                            <block type="text" id="text_2">
                                <field name="TEXT">Name an animal:</field>
                            </block>
                        </value>
                    </block>
                </value>
                <next>
                    <block type="text_print" id="print_2">
                        <value name="TEXT">
                            <block type="text_join" id="join_1">
                                <mutation items="3"></mutation>
                                <value name="ADD0">
                                    <block type="text" id="text_3">
                                        <field name="TEXT">The </field>
                                    </block>
                                </value>
                                <value name="ADD1">
                                    <block type="variables_get" id="get_1">
                                        <field name="VAR" id="var_animal">animal</field>
                                    </block>
                                </value>
                                <value name="ADD2">
                                    <block type="text" id="text_4">
                                        <field name="TEXT"> danced on the moon!</field>
                                    </block>
                                </value>
                            </block>
                        </value>
                        <next>
                            <block type="text_print" id="print_3">
                                <value name="TEXT">
                                    <block type="text" id="text_5">
                                        <field name="TEXT">Ha ha ha!</field>
                                    </block>
                                </value>
                            </block>
                        </next>
                    </block>
                </next>
            </block>
        </next>
    </block>
</xml>
