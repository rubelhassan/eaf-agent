<xml xmlns="https://developers.google.com/blockly/xml">
    <variables>
        <variable id="var_tasksDone">tasksDone</variable>
        <variable id="var_points">points</variable>
    </variables>
    <block type="variables_set" id="set_1" x="20" y="20">
        <field name="VAR" id="var_tasksDone">tasksDone</field>
        <value name="VALUE">
            <block type="text_prompt_ext" id="prompt_1">
                <mutation type="NUMBER"></mutation>
                <field name="TYPE">NUMBER</field>
                <value name="TEXT">
                    <block type="text" id="uXP)bEwZG9L^3.^z#4jA">
                        <field name="TEXT">How many tasks did you finish? (1 to 10)</field>
                    </block>
                </value>
            </block>
        </value>
        <next>
            <block type="variables_set" id="set_2">
                <field name="VAR" id="var_points">points</field>
                <value name="VALUE">
                    <block type="math_number" id="num_0">
                        <field name="NUM">0</field>
                    </block>
                </value>
                <next>
                    <block type="text_print" id="print_1">
                        <value name="TEXT">
                            <block type="text" id="text_1">
                                <field name="TEXT">Earning points...</field>
                            </block>
                        </value>
                        <next>
                            <block type="controls_repeat_ext" id="repeat_1">
                                <value name="TIMES">
                                    <block type="variables_get" id="get_1">
                                        <field name="VAR" id="var_tasksDone">tasksDone</field>
                                    </block>
                                </value>
                                <statement name="DO">
                                    <block type="variables_set" id="set_3">
                                        <field name="VAR" id="var_points">points</field>
                                        <value name="VALUE">
                                            <block type="math_arithmetic" id="arith_1">
                                                <field name="OP">ADD</field>
                                                <value name="A">
                                                    <block type="variables_get" id="get_2">
                                                        <field name="VAR" id="var_points">points</field>
                                                    </block>
                                                </value>
                                                <value name="B">
                                                    <block type="math_number" id="num_2">
                                                        <field name="NUM">2</field>
                                                    </block>
                                                </value>
                                            </block>
                                        </value>
                                    </block>
                                </statement>
                                <next>
                                    <block type="text_print" id="print_2">
                                        <value name="TEXT">
                                            <block type="text_join" id="join_1">
                                                <mutation items="2"></mutation>
                                                <value name="ADD0">
                                                    <block type="text" id="text_2">
                                                        <field name="TEXT">Points: </field>
                                                    </block>
                                                </value>
                                                <value name="ADD1">
                                                    <block type="variables_get" id="get_3">
                                                        <field name="VAR" id="var_points">points</field>
                                                    </block>
                                                </value>
                                            </block>
                                        </value>
                                        <next>
                                            <block type="controls_if" id="if_1">
                                                <mutation else="1"></mutation>
                                                <value name="IF0">
                                                    <block type="logic_compare" id="cmp_1">
                                                        <field name="OP">GT</field>
                                                        <value name="A">
                                                            <block type="variables_get" id="get_4">
                                                                <field name="VAR" id="var_points">points</field>
                                                            </block>
                                                        </value>
                                                        <value name="B">
                                                            <block type="math_number" id="num_10">
                                                                <field name="NUM">10</field>
                                                            </block>
                                                        </value>
                                                    </block>
                                                </value>
                                                <statement name="DO0">
                                                    <block type="text_print" id="print_3">
                                                        <value name="TEXT">
                                                            <block type="text" id="text_3">
                                                                <field name="TEXT">Level up!</field>
                                                            </block>
                                                        </value>
                                                    </block>
                                                </statement>
                                                <statement name="ELSE">
                                                    <block type="text_print" id="print_4">
                                                        <value name="TEXT">
                                                            <block type="text" id="text_4">
                                                                <field name="TEXT">Keep practicing!</field>
                                                            </block>
                                                        </value>
                                                    </block>
                                                </statement>
                                            </block>
                                        </next>
                                    </block>
                                </next>
                            </block>
                        </next>
                    </block>
                </next>
            </block>
        </next>
    </block>
</xml>
