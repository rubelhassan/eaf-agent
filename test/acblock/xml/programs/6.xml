<xml xmlns="https://developers.google.com/blockly/xml">
    <variables>
        <variable id="var_stars">stars</variable>
    </variables>
    <block type="variables_set" id="set_1" x="20" y="20">
        <field name="VAR" id="var_stars">stars</field>
        <value name="VALUE">
            <block type="math_number" id="num_0">
                <field name="NUM">0</field>
            </block>
        </value>
        <next>
            <block type="controls_repeat_ext" id="repeat_1">
                <value name="TIMES">
                    <block type="math_number" id="num_4">
                        <field name="NUM">4</field>
                    </block>
                </value>
                <statement name="DO">
                    <block type="variables_set" id="set_2">
                        <field name="VAR" id="var_stars">stars</field>
                        <value name="VALUE">
                            <block type="math_arithmetic" id="arith_1">
                                <field name="OP">ADD</field>
                                <value name="A">
                                    <block type="variables_get" id="get_1">
                                        <field name="VAR" id="var_stars">stars</field>
                                    </block>
                                </value>
                                <value name="B">
                                    <block type="math_number" id="num_1">
                                        <field name="NUM">1</field>
                                    </block>
                                </value>
                            </block>
                        </value>
                    </block>
                </statement>
                <next>
                    <block type="text_print" id="print_1">
                        <value name="TEXT">
                            <block type="variables_get" id="get_2">
                                <field name="VAR" id="var_stars">stars</field>
                            </block>
                        </value>
                    </block>
                </next>
            </block>
        </next>
    </block>
</xml>
