        <value name="VALUE">
            <block type="text_prompt_ext" id="prompt_1">
                <mutation type="TEXT"></mutation>
                <field name="TYPE">TEXT</field>
                <value name="TEXT">
                    <block type="text" id="qB,P@@_J^?19R`U.Ln0O">
                        <field name="TEXT">What is your name?</field>
                    </block>
                </value>
            </block>
        </value>
        <next>
