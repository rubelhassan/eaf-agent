<xml xmlns="https://developers.google.com/blockly/xml">
    <variables>
        <variable id="var_cookies">cookies</variable>
    </variables>
    <block type="text_print" id="print_1" x="20" y="20">
        <value name="TEXT">
            <block type="text" id="text_1">
                <field name="TEXT">Welcome to the Cookie Shop!</field>
            </block>
        </value>
        <next>
            <block type="variables_set" id="set_1">
                <field name="VAR" id="var_cookies">cookies</field>
                <value name="VALUE">
                    <block type="text_prompt_ext" id="prompt_1">
                        <mutation type="NUMBER"></mutation>
                        <field name="TYPE">NUMBER</field>
                        <value name="TEXT">
                            <block type="text" id="text_2">
                                <field name="TEXT">How many cookies?</field>
                            </block>
                        </value>
                    </block>
                </value>
                <next>
                    <block type="controls_repeat_ext" id="repeat_1">
                        <value name="TIMES">
                            <block type="math_number" id="num_3">
                                <field name="NUM">3</field>
                            </block>
                        </value>
                        <statement name="DO">
                            <block type="variables_set" id="set_2">
                                <field name="VAR" id="var_cookies">cookies</field>
                                <value name="VALUE">
                                    <block type="math_arithmetic" id="arith_1">
                                        <field name="OP">ADD</field>
                                        <value name="A">
                                            <block type="variables_get" id="get_1">
                                                <field name="VAR" id="var_cookies">cookies</field>
                                            </block>
                                        </value>
                                        <value name="B">
                                            <block type="math_number" id="num_2">
                                                <field name="NUM">2</field>
                                            </block>
                                        </value>
                                    </block>
                                </value>
                                <next>
                                    <block type="text_print" id="print_2">
                                        <value name="TEXT">
                                            <block type="variables_get" id="get_2">
                                                <field name="VAR" id="var_cookies">cookies</field>
                                            </block>
                                        </value>
                                    </block>
                                </next>
                            </block>
                        </statement>
                        <next>
                            <block type="text_print" id="print_3">
                                <value name="TEXT">
                                    <block type="text_join" id="join_1">
                                        <mutation items="2"></mutation>
                                        <value name="ADD0">
                                            <block type="text" id="text_3">
                                                <field name="TEXT">Total: </field>
                                            </block>
                                        </value>
                                        <value name="ADD1">
                                            <block type="variables_get" id="get_3">
                                                <field name="VAR" id="var_cookies">cookies</field>
                                            </block>
                                        </value>
                                    </block>
                                </value>
                            </block>
                        </next>
                    </block>
                </next>
            </block>
        </next>
    </block>
</xml>
