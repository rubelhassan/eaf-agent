<xml xmlns="https://developers.google.com/blockly/xml">
    <variables>
        <variable id="var_astronautName">astronautName</variable>
        <variable id="var_stars">stars</variable>
    </variables>
    <block type="variables_set" id="set_1" x="20" y="20">
        <field name="VAR" id="var_astronautName">astronautName</field>
        <value name="VALUE">
            <block type="text_prompt_ext" id="prompt_1">
                <mutation type="TEXT"></mutation>
                <field name="TYPE">TEXT</field>
                <value name="TEXT">
                    <block type="text" id="text_prompt_1">
                        <field name="TEXT">Astronaut name?</field>
                    </block>
                </value>
            </block>
        </value>
        <next>
            <block type="variables_set" id="set_2">
                <field name="VAR" id="var_stars">stars</field>
                <value name="VALUE">
                    <block type="math_number" id="num_0">
                        <field name="NUM">0</field>
                    </block>
                </value>
                <next>
                    <block type="controls_repeat_ext" id="repeat_1">
                        <value name="TIMES">
                            <block type="math_number" id="num_4">
                                <field name="NUM">4</field>
                            </block>
                        </value>
                        <statement name="DO">
                            <block type="variables_set" id="set_3">
                                <field name="VAR" id="var_stars">stars</field>
                                <value name="VALUE">
                                    <block type="math_arithmetic" id="arith_1">
                                        <field name="OP">ADD</field>
                                        <value name="A">
                                            <block type="variables_get" id="get_1">
                                                <field name="VAR" id="var_stars">stars</field>
                                            </block>
                                        </value>
                                        <value name="B">
                                            <block type="math_number" id="num_1">
                                                <field name="NUM">1</field>
                                            </block>
                                        </value>
                                    </block>
                                </value>
                                <next>
                                    <block type="text_print" id="print_1">
                                        <value name="TEXT">
                                            <block type="text" id="text_1">
                                                <field name="TEXT">Star!</field>
                                            </block>
                                        </value>
                                    </block>
                                </next>
                            </block>
                        </statement>
                        <next>
                            <block type="text_print" id="print_2">
                                <value name="TEXT">
                                    <block type="text_join" id="join_1">
                                        <mutation items="2"></mutation>
                                        <value name="ADD0">
                                            <block type="text" id="text_2">
                                                <field name="TEXT">Blast off, </field>
                                            </block>
                                        </value>
                                        <value name="ADD1">
                                            <block type="variables_get" id="get_2">
                                                <field name="VAR" id="var_astronautName">astronautName</field>
                                            </block>
                                        </value>
                                    </block>
                                </value>
                            </block>
                        </next>
                    </block>
                </next>
            </block>
        </next>
    </block>
</xml>
